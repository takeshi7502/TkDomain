# Keep real values out of git. Add them as Vercel Environment Variables.
# CLOUDFLARE_API_TOKEN needs Zone > DNS > Edit and Zone > Zone > Read on every
# zone that will be added in Admin > Domains. Do not use a Global API Key.
# CLOUDFLARE_ZONE_ID remains the one-time legacy seed/fallback for takeshi.dev.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
REGISTRY_ADMIN_KEY=
# IMPORTANT: initially set to the exact CURRENT REGISTRY_ADMIN_KEY value.
# Never rotate this when changing the admin password; existing hashes depend on it.
REGISTRY_AUTH_SECRET=
# Long random value authenticating /api/maintenance (Vercel Cron/admin).
CRON_SECRET=
DNS_RECORD_LIMIT=50
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
REGISTRY_PUBLIC_URL=https://domain.takeshi.dev
# Verify mail.takeshi.dev in Resend before using this sender.
RESEND_API_KEY=
EMAIL_FROM=Takeshi Domains <notify@mail.takeshi.dev>
